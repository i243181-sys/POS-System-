# Electron reads exported environment variables; it does not load this file automatically.
# POS_DATA_DIR must be absolute. Unset it to preserve Electron's existing user-data location.
# POS_DATA_DIR=/absolute/private/path/to/securestore-data
# LOG_LEVEL=info
# Optional unattended initial accounts; use the on-screen first-run setup instead when possible.
# Minimum 12 characters, maximum 72 UTF-8 bytes. No default credentials exist.
# POS_INITIAL_ADMIN_PASSWORD=
# POS_INITIAL_CASHIER_PASSWORD=
